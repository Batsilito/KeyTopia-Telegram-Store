# Runtime
# Primary database connection. Use the exact secret key Neon_Connection in Replit.
Neon_Connection=postgresql://user:password@host/database
# Optional legacy fallback:
# DATABASE_URL=postgresql://user:password@host/database
SESSION_SECRET=replace-with-a-long-random-value
NODE_ENV=production
PORT=8080

# Independent admin bootstrap. The password must be stored as a workspace secret
# in production; do not commit a real value here.
INITIAL_SUPERADMIN_EMAIL=operator@example.com
INITIAL_SUPERADMIN_PASSWORD=

# Telegram. Leave these unset to keep the bot disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://your-domain.example/telegram/webhook
